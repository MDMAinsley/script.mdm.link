<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
  <category label="Sources">
    <setting id="source_mode" type="select" label="Source mode" values="Free|Debrid|Combined" default="Combined" />
    <setting id="provider_archive" type="bool" label="Internet Archive (free direct video)" default="true" />
    <setting id="provider_torrentio" type="bool" label="Torrentio (requires AllDebrid)" default="true" />
  </category>
  <category label="Additional stream providers">
    <setting id="provider_stream_1_enabled" type="bool" label="Enable stream provider 1" default="true" />
    <setting id="provider_stream_1_url" type="text" option="hidden" label="Provider 1 base / manifest URL" default="" />
    <setting id="provider_stream_2_enabled" type="bool" label="Enable stream provider 2" default="true" />
    <setting id="provider_stream_2_url" type="text" option="hidden" label="Provider 2 base / manifest URL" default="" />
    <setting id="provider_stream_3_enabled" type="bool" label="Enable stream provider 3" default="true" />
    <setting id="provider_stream_3_url" type="text" option="hidden" label="Provider 3 base / manifest URL" default="" />
  </category>
  <category label="AllDebrid">
    <setting id="alldebrid_enabled" type="bool" label="Enable AllDebrid (prioritised in Combined)" default="true" />
    <setting id="alldebrid_api_key" type="text" option="hidden" label="API key (or authorise from Link menu / Flix Tools)" default="" />
    <setting id="flix_account_imported" type="bool" visible="false" default="false" />
    <setting id="last_search_status" type="text" visible="false" default="" />
    <setting id="last_search_summary" type="text" visible="false" default="" />
  </category>
<category label="Device tuning"><setting id="device_quality_max" type="select" label="Maximum reported quality" default="Unlimited" values="Unlimited|720p|1080p|4K" /><setting id="device_unknown_quality" type="select" label="Unknown source quality" default="Show" values="Show|Hide" /><setting id="device_workers" type="integer" label="Provider workers" default="5" /><setting id="device_search_timeout" type="integer" label="Search budget (10-120 seconds)" default="30" /><setting id="device_request_timeout" type="integer" label="Request timeout (10-60 seconds)" default="10" /></category>
<category label="Connection / file size"><setting id="device_connection_mbps" type="text" label="Connection speed Mbps (0 = off; max 10000)" default="0" /><setting id="device_max_size_gib" type="text" label="Maximum reported size GiB (0 = unlimited; max 10000)" default="0" /><setting id="device_source_order" type="select" label="Source order" default="Quality" values="Quality|Connection|Smallest" /><setting id="device_unknown_size" type="select" label="Unknown size when size limit is active" default="Show" values="Show|Hide" /><setting id="device_slow_sources" type="select" label="Above estimated connection budget" default="Show" values="Show|Hide" /><setting id="device_unknown_bitrate" type="select" label="Unknown bitrate when connection is active" default="Show" values="Show|Hide" /></category>
</settings>
